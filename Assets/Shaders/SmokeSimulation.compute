// ============================================================
//  SmokeSimulation.compute
//  Two kernels run each frame, in order:
//    1. AdvectVelocity  – moves the velocity field along itself
//                         and applies buoyancy
//    2. AdvectDensity   – moves density along the velocity field,
//                         emits new density, dissipates
// ============================================================

// Each #kernel tells which function to compile; you can have many kernels
#pragma kernel AdvectVelocity
#pragma kernel AdvectDensity

// ── ping-pong density ────────────────────────────────────────
RWTexture3D<float>  _DensityWrite;
Texture3D<float>    _DensityRead;

// ── ping-pong velocity (xyz stored in rgb) ───────────────────
RWTexture3D<float4> _VelocityWrite;
Texture3D<float4>   _VelocityRead;

SamplerState        sampler_DensityRead;
SamplerState        sampler_VelocityRead;

// ── uniforms ─────────────────────────────────────────────────
float3 _GridSize;        // voxel dimensions (e.g. 64,64,64)
float  _DeltaTime;
float  _Time;            // used to animate noise offset

// Density
float  _Dissipation;     // how fast density fades (0.99 = slow, 0.95 = fast)
float  _EmitRate;        // density injected per second at source
float3 _EmitPos;         // source position in voxel coords
float  _EmitRadius;      // source radius in voxels

// Velocity
float  _BuoyancyStrength;    // how hard density pushes fluid upward (voxels/sec)
float  _VelocityDissipation; // velocity drag — lower = more viscous
float  _NoiseStrength;

// ── helpers ──────────────────────────────────────────────────

float3 SampleVelocity(float3 voxelPos)
{
    float3 uvw = (voxelPos + 0.5) / _GridSize;
    uvw = saturate(uvw);
    return _VelocityRead.SampleLevel(sampler_VelocityRead, uvw, 0).xyz;
}

float SampleDensity(float3 voxelPos)
{
    float3 uvw = (voxelPos + 0.5) / _GridSize;
    uvw = saturate(uvw);
    return _DensityRead.SampleLevel(sampler_DensityRead, uvw, 0).r;
}

// ── simple noise helpers ───
float hash(float3 p)
{
    p = frac(p * float3(127.1, 311.7, 74.7));
    p += dot(p, p.yzx + 19.19);
    return frac((p.x + p.y) * p.z);
}

float noise3(float3 p)
{
    float3 i = floor(p);
    float3 f = frac(p);
    f = f * f * (3.0 - 2.0 * f); // smoothstep

    return lerp(
        lerp(lerp(hash(i),                 hash(i + float3(1,0,0)), f.x),
             lerp(hash(i + float3(0,1,0)), hash(i + float3(1,1,0)), f.x), f.y),
        lerp(lerp(hash(i + float3(0,0,1)), hash(i + float3(1,0,1)), f.x),
             lerp(hash(i + float3(0,1,1)), hash(i + float3(1,1,1)), f.x), f.y),
        f.z);
}

float3 SeedNoise(uint3 id)
{
    float3 p = float3(id) * 0.18 + float3(0, _Time * 0.5, 0);
    float nx = (noise3(p)                        - 0.5) * 2.0;
    float ny = (noise3(p + float3(3.1, 0,   7.4)) - 0.5) * 2.0;
    float nz = (noise3(p + float3(1.7, 5.2, 0  )) - 0.5) * 2.0;
    return float3(nx, ny, nz) * _NoiseStrength;
}

// ── Kernels ───

// Must match the thread groups in SmokeSimulation.cs
// Each work chunk is 8x8x8
// - extras that don't divide cleanly are removed

// ── Kernel 1: Advect Velocity ─────────────────────────────────
[numthreads(8, 8, 8)]
void AdvectVelocity(uint3 id : SV_DispatchThreadID)
{
    if (any(id >= (uint3)_GridSize)) return;

    // Semi-Lagrangian: trace back along current velocity
    float3 vel      = SampleVelocity(float3(id));
    float3 prevPos  = float3(id) - vel * _DeltaTime;
    float3 advected = SampleVelocity(prevPos);

    // Buoyancy: density pushes upward (so sample from below)
    float  density  = SampleDensity(float3(id) - float3(0, 1, 0));
    float3 buoyancy = float3(0, density * _BuoyancyStrength, 0);

    float3 newVel = advected + buoyancy * _DeltaTime;

    // Seed noise near the emitter to start turbulence
    float distToEmit = length(float3(id) - _EmitPos);
    if (distToEmit < _EmitRadius * 2.0)
        newVel += SeedNoise(id) * _DeltaTime;

    // Damping
    newVel *= pow(_VelocityDissipation, _DeltaTime * 60.0);

    _VelocityWrite[id] = float4(newVel, 0);
}

// ── Kernel 2: Advect Density ──────────────────────────────────
[numthreads(8, 8, 8)]
void AdvectDensity(uint3 id : SV_DispatchThreadID)
{
    if (any(id >= (uint3)_GridSize)) return;

    // Semi-Lagrangian: trace back along velocity to find source density
    float3 vel     = SampleVelocity(float3(id));
    float3 prevPos = float3(id) - vel * _DeltaTime;
    float  density = SampleDensity(prevPos);

    // Dissipation
    density *= pow(_Dissipation, _DeltaTime * 60.0);

    // Emission
    float distToSource = length(float3(id) - _EmitPos);
    if (distToSource < _EmitRadius)
    {
        float falloff = 1.0 - (distToSource / _EmitRadius);
        density += _EmitRate * _DeltaTime * (falloff * falloff);
    }

    _DensityWrite[id] = saturate(density);
}

